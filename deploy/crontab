# The only crontab on the server. It starts the scheduler every minute; the scheduler runs each
# dashboard / automation job once a day at the time set on the website (Automations → Schedules).
# Install (replaces root's whole crontab):
#   crontab /root/naar_automations/deploy/crontab
SHELL=/bin/bash
APP=/root/naar_automations

* * * * * cd $APP && venv/bin/python -m web.scheduler >> logs/scheduler.log 2>&1
