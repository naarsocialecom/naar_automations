# Incidents & Operations daily Slack update (7 PM summary), for root's crontab:
#   crontab /root/naar_automations/dashboards/incidents_operations/crontab
# (this replaces root's whole crontab, so add any other jobs you have to this file first)
#
# Times are UTC (the server clock): 7 PM IST = 13:30 UTC.
# (The 6 PM developer-update reminder is off; to bring it back set NDO_DEVELOPER_UPDATES=true and add:
#  30 12 * * * cd $APP && venv/bin/python -m dashboards.incidents_operations.daily remind >> logs/incidents-operations-daily.log 2>&1)
SHELL=/bin/bash
APP=/root/naar_automations

30 13 * * * cd $APP && venv/bin/python -m dashboards.incidents_operations.daily post >> logs/incidents-operations-daily.log 2>&1
